---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/inter-tight/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "GTM advice that isn't trying to sell you a retainer.",
  ogImage = '/og/default.png',
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site);

// TODO: replace with your real GA4 Measurement ID (Admin → Data Streams → your stream)
const GA4_MEASUREMENT_ID = 'G-K3N90FXN62';
// TODO: replace with your real Cloudflare Web Analytics token (Analytics & Logs → Web Analytics → Manage site)
const CF_ANALYTICS_TOKEN = 'YOUR-CLOUDFLARE-BEACON-TOKEN';

const ga4Enabled = GA4_MEASUREMENT_ID !== 'G-XXXXXXXXXX';
const cfAnalyticsEnabled = CF_ANALYTICS_TOKEN !== 'YOUR-CLOUDFLARE-BEACON-TOKEN';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo-stamp.svg" />
    <title>{title} · dumbGTM</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · dumbGTM`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · dumbGTM`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ga4Enabled && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
        <script define:vars={{ GA4_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA4_MEASUREMENT_ID);
        </script>
      </Fragment>
    )}
  </head>
  <body class="font-body text-ink min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    {cfAnalyticsEnabled && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}></script>
    )}
  </body>
</html>
