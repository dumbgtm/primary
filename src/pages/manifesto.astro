---
import BaseLayout from '../layouts/BaseLayout.astro';

const rules = [
  "If it needs an acronym, it's not a strategy. It's a symptom.",
  'Nobody forwards a 40-slide deck. They forward one sentence.',
  '"10x your pipeline" is a Craigslist ad with better fonts.',
  "AI can write the email. It can't make anyone want to open it.",
  'If the case study skips the funding round, assume there was a funding round.',
  'Ten real customer conversations beat ten frameworks about having them.',
  "If you can't explain it in one sentence, it's an invoice waiting to happen.",
  "Automating the follow-up doesn't fix the offer. It just spams more people with the same bad one.",
  "If everyone in your market is doing it, it's not an edge. It's a tax.",
  "The best idea in the room is rarely the one somebody's charging $20k to say.",
];
---
<BaseLayout
  title="Manifesto"
  description="10 rules of dumb GTM. Nothing here needs a framework."
  ogImage="/og/manifesto.png"
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <p class="tag mb-6">nothing here needs a framework</p>
    <h1 class="font-display font-extrabold text-3xl sm:text-5xl mb-4 leading-tight text-ink">
      The dumbGTM Manifesto
    </h1>
    <p class="text-lg mb-12 max-w-xl text-ink/70">
      Ten rules. No slide numbers. Steal them, screenshot them, argue with them.
    </p>

    <ol class="space-y-8">
      {rules.map((rule, i) => (
        <li class="flex gap-5 items-start">
          <span class="font-display font-extrabold text-3xl sm:text-4xl text-siren leading-none shrink-0 w-10 sm:w-12 text-right">
            {i + 1}
          </span>
          <p class="font-display font-bold text-xl sm:text-2xl leading-snug text-ink pt-1">
            {rule}
          </p>
        </li>
      ))}
    </ol>

    <div class="mt-16 rounded-2xl bg-frost/20 p-8 text-center">
      <p class="font-display font-bold text-lg mb-4 text-ink">Think we're wrong about one of these?</p>
      <a href="/contact" class="btn-solid">Make your case</a>
    </div>
  </section>
</BaseLayout>
