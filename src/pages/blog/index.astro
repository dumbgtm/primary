---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemoHeader from '../../components/MemoHeader.astro';
import MemoList from '../../components/MemoList.astro';
import { getCollection } from 'astro:content';
import { STAGES, STAGE_KEYS } from '../../lib/site';

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const items = all.map((p, i) => ({ post: p, n: i + 1 })).reverse();
---
<BaseLayout title="Blog" description="Contrarian marketing ideas, the ones that work and the ones everybody copied until they stopped working.">
  <section class="container-memo pt-12 sm:pt-16 pb-8">
    <div class="max-w-[760px] flex flex-col gap-7">
      <MemoHeader rows={[
        { label: 'TO:', value: 'All readers' },
        { label: 'FROM:', value: 'dumbGTM' },
        { label: 'RE:', value: 'New dumb ideas, roughly weekly' },
      ]} />
      <h1 class="t-h1 text-ink">The Blog</h1>
      <p class="t-body-mono max-w-[60ch]">
        Marketing ideas at every stage of the loop. Some are early and weird. Some used to work and have been run into the ground. Every post says which stage it thinks the idea is in.
      </p>
    </div>
  </section>

  <section class="container-memo pb-8">
    {items.length === 0 ? (
      <p class="t-small">Nothing here yet. Someone is still being laughed at in a meeting.</p>
    ) : (
      <>
        <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Filter by loop stage">
          <span class="t-label text-muted mr-2">Filter:</span>
          <button type="button" data-filter="all" aria-pressed="true" class="stage-filter">All</button>
          {STAGE_KEYS.map((key) => (
            <button type="button" data-filter={key} aria-pressed="false" class="stage-filter">
              §{STAGES[key].n} {STAGES[key].label}
            </button>
          ))}
        </div>
        <MemoList items={items} filterable />
        <p id="no-posts" class="hidden t-small py-6">No posts at this stage yet. Give it a quarter.</p>
      </>
    )}
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.stage-filter');
  const rows = document.querySelectorAll<HTMLElement>('.memo-row');
  const empty = document.getElementById('no-posts');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      rows.forEach((row) => {
        const show = f === 'all' || row.dataset.stage === f;
        row.classList.toggle('hidden', !show);
        if (show) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    });
  });
</script>

<style>
  .stage-filter {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border: 1px solid var(--ink);
    color: var(--ink);
    background: var(--memo);
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .stage-filter:hover { background: var(--carbon); }
  .stage-filter[aria-pressed='true'] { background: var(--ink); color: var(--memo); }
</style>
