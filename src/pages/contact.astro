---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MemoHeader from '../components/MemoHeader.astro';

const topics = [
  { value: 'idea', label: 'A dumb idea I want to share' },
  { value: 'fired', label: 'I got fired (or ignored) for one too' },
  { value: 'rebuttal', label: 'A rebuttal to a post' },
  { value: 'collab', label: 'Collab or sponsorship' },
];
---
<BaseLayout title="Contact" description="Send us the marketing idea your team laughed at.">
  <section class="container-memo pt-12 sm:pt-16">
    <div class="max-w-[640px] flex flex-col gap-7">
      <MemoHeader rows={[
        { label: 'TO:', value: 'You' },
        { label: 'FROM:', value: 'dumbGTM' },
        { label: 'RE:', value: 'A real human reads these' },
      ]} />
      <h1 class="t-h1 text-ink">Got a dumb idea?</h1>
      <p class="t-body-mono">
        Send me the marketing idea your team laughed at. If it's interesting I might write about it
        or make a video, and only with your OK. I can leave your name and company out. Rebuttals and
        collab ideas are welcome too.
      </p>

      <!--
        Wire this form to Formspree (or any form backend) before launch:
        1. Create a free form at https://formspree.io
        2. Replace YOUR_FORM_ID below with the endpoint they give you.
        Until then this form won't actually send anywhere.
      -->
      <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="border border-ink p-5 sm:p-8 flex flex-col gap-6">
        <p class="t-label text-muted border-b border-rule pb-3 inline-flex items-center gap-2"><Icon name="clipboard" size={16} />Form DG-1: Idea submission</p>
        <div>
          <label for="name" class="t-label text-ink block mb-2">Name</label>
          <input id="name" name="name" type="text" required class="field" />
        </div>
        <div>
          <label for="email" class="t-label text-ink block mb-2">Email</label>
          <input id="email" name="email" type="email" required class="field" />
        </div>
        <div>
          <label for="message" class="t-label text-ink block mb-2">Message</label>
          <textarea id="message" name="message" rows="6" required class="field ruled-field resize-y"></textarea>
        </div>
        <fieldset class="border border-ink p-4">
          <legend class="t-label text-ink px-1">What's this about?</legend>
          <div class="flex flex-col gap-3 mt-1">
            {topics.map((t) => (
              <label class="flex items-start gap-3 font-mono text-[14px] text-ink2 leading-[1.5] cursor-pointer">
                <input type="checkbox" name="topic" value={t.value} class="check mt-[3px]" />
                {t.label}
              </label>
            ))}
          </div>
        </fieldset>
        <div>
          <button type="submit" class="btn-primary"><Icon name="mail" size={16} />Send it</button>
        </div>
      </form>

      <p class="t-small">
        Prefer email? <a href="mailto:hello@dumbgtm.com" class="link inline-flex items-center gap-[6px]"><Icon name="mail" size={12} />hello@dumbgtm.com</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .check {
    appearance: none;
    width: 16px; height: 16px;
    flex: none;
    border: 1px solid var(--ink);
    background: var(--carbon);
    display: inline-grid;
    place-content: center;
  }
  .check::before { content: ''; width: 8px; height: 8px; background: var(--ink); transform: scale(0); transition: transform 120ms ease-out; }
  .check:checked::before { transform: scale(1); }
  /* Ruled paper message box (Graphics Kit §04.6) */
  .ruled-field {
    background-color: var(--memo);
    background-image:
      linear-gradient(90deg, transparent 47px, var(--staple) 47px, var(--staple) 48px, transparent 48px),
      repeating-linear-gradient(180deg, transparent 0 27px, var(--rule) 27px 28px);
    background-attachment: local;
    line-height: 28px;
    padding: 0 12px 0 64px;
  }
  .ruled-field:focus { background-color: var(--memo); }
  .check:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
</style>
