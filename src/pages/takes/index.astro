---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const takes = (await getCollection('takes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Hot Takes" description="Short, unfiltered opinions on GTM slop. No decks required.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <p class="tag mb-6">one idea at a time, no deck required</p>
    <h1 class="font-display font-extrabold text-3xl sm:text-5xl mb-4 leading-tight text-ink">Hot Takes</h1>
    <p class="text-lg mb-10 max-w-xl text-ink/70">
      The short version of the blog, for people who don't have time for the long version of the blog.
    </p>

    {takes.length === 0 ? (
      <p class="text-slate">Nothing here yet. Give it a minute.</p>
    ) : (
      <div class="space-y-5">
        {takes.map(async (take) => {
          const { Content } = await take.render();
          return (
            <a href={`/takes/${take.slug}`} class="block rounded-2xl border border-ink/10 bg-white/40 p-6 sm:p-8 hover:bg-frost/20 hover:border-ink/20 transition-colors">
              <div class="prose-dumb-take font-display font-bold text-xl sm:text-2xl leading-snug text-ink">
                <Content />
              </div>
              <div class="flex items-center justify-between mt-4">
                <p class="text-xs uppercase tracking-wide text-slate">
                  {take.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
                {take.data.tags.length > 0 && (
                  <div class="flex gap-2 flex-wrap">
                    {take.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>
