---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const takes = await getCollection('takes', ({ data }) => !data.draft);
  return takes.map((take) => ({
    params: { slug: take.slug },
    props: { take },
  }));
}

const { take } = Astro.props;
const { Content } = await take.render();

const plainText = take.body.trim();
const description = plainText.length > 155 ? `${plainText.slice(0, 152)}...` : plainText;
---
<BaseLayout title="A Hot Take" description={description} ogImage={`/og/takes/${take.slug}.png`}>
  <article class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <a href="/takes" class="text-sm text-slate hover:text-siren">&larr; All takes</a>
    <p class="text-xs uppercase tracking-wide text-slate mt-6 mb-6">
      {take.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
    </p>
    <blockquote class="prose-dumb-take font-display font-extrabold text-3xl sm:text-4xl leading-tight text-ink border-l-4 border-siren pl-6">
      <Content />
    </blockquote>
    {take.data.tags.length > 0 && (
      <div class="flex gap-2 mt-8 flex-wrap">
        {take.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
    <p class="mt-10 text-sm text-slate">
      Agree, disagree, or have a worse example? <a href="/contact" class="text-cerulean underline decoration-2 underline-offset-2 hover:text-siren">Tell us</a>.
    </p>
  </article>
</BaseLayout>
