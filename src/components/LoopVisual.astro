---
// The dumb idea loop: four stops on a ring, a dot travelling clockwise.
// The dot fades from Siren to Slate as the idea gets copied, sits at Slate
// through "boring", then turns red again when the next dumb idea shows up.
import { STAGES } from '../lib/site';

const cx = 200, cy = 200, r = 140;
const stops = [
  { key: 'dumb', x: cx, y: cy - r, w: 76 },
  { key: 'working', x: cx + r, y: cy, w: 96 },
  { key: 'everywhere', x: cx, y: cy + r, w: 120 },
  { key: 'boring', x: cx - r, y: cy, w: 88 },
] as const;

// Ring segments, each starting in its stage colour.
const pt = (deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const arcs = [-90, 0, 90, 180].map((start, i) => {
  const [x1, y1] = pt(start);
  const [x2, y2] = pt(start + 90);
  return { d: `M${x1},${y1} A${r},${r} 0 0 1 ${x2},${y2}`, color: STAGES[stops[i].key].color };
});
// Direction arrows at the middle of each segment.
const arrows = [-45, 45, 135, 225].map((deg, i) => {
  const [x, y] = pt(deg);
  return { x, y, rot: deg + 90, color: STAGES[stops[i].key].color };
});

const c = stops.map((s) => STAGES[s.key].color);
const path = `M${cx},${cy - r} A${r},${r} 0 0 1 ${cx},${cy + r} A${r},${r} 0 0 1 ${cx},${cy - r}`;
const dotColors = [c[0], c[1], c[2], c[3], c[3], c[0]].join(';');
---
<figure class="loop-visual rounded-2xl bg-frost/15 border border-ink/10 p-6 sm:p-8">
  <svg viewBox="0 0 400 400" class="w-full h-auto max-w-md mx-auto" role="img"
    aria-label="The dumb idea loop: dumb, then working, then everywhere, then boring, then a new dumb idea starts it again.">
    {arcs.map((a) => (
      <path d={a.d} fill="none" stroke={a.color} stroke-opacity="0.35" stroke-width="6" stroke-linecap="round" />
    ))}
    {arrows.map((a) => (
      <polygon points="-6,-7 8,0 -6,7" fill={a.color} fill-opacity="0.6"
        transform={`translate(${a.x} ${a.y}) rotate(${a.rot})`} />
    ))}

    <text x={cx} y={cy + 5} text-anchor="middle" class="font-display font-bold fill-slate" font-size="15" letter-spacing="1.5">REPEAT</text>

    <g>
      <circle r="17" fill={c[0]} fill-opacity="0.18">
        <animateMotion dur="10s" repeatCount="indefinite" path={path} />
        <animate attributeName="fill" dur="10s" repeatCount="indefinite" values={dotColors} keyTimes="0;0.25;0.5;0.75;0.96;1" />
      </circle>
    </g>

    <circle r="8" fill={c[0]} stroke="#E9FFF9" stroke-width="3">
      <animateMotion dur="10s" repeatCount="indefinite" path={path} />
      <animate attributeName="fill" dur="10s" repeatCount="indefinite" values={dotColors} keyTimes="0;0.25;0.5;0.75;0.96;1" />
    </circle>

    {stops.map((s, i) => (
      <g class={`stop stop-${i}`} style={`transform-origin:${s.x}px ${s.y}px`}>
        <rect x={s.x - s.w / 2} y={s.y - 17} width={s.w} height="34" rx="17" fill={STAGES[s.key].color} />
        <text x={s.x} y={s.y + 5} text-anchor="middle" class="font-display font-bold fill-paper" font-size="14">
          {STAGES[s.key].label.toLowerCase()}
        </text>
      </g>
    ))}

  </svg>
</figure>

<script>
  // SMIL animations ignore CSS, so pause them for people who prefer less motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.loop-visual svg').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(0);
    });
  }
</script>

<style>
  .loop-visual svg { overflow: visible; }
  .stop { animation: stop-pulse 10s ease-out infinite; }
  .stop-1 { animation-delay: 2.5s; }
  .stop-2 { animation-delay: 5s; }
  .stop-3 { animation-delay: 7.5s; }
  @keyframes stop-pulse {
    0% { transform: scale(1.14); }
    10%, 100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stop { animation: none; }
  }
</style>
