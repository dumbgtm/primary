---
// Fig. 1: the dumb idea loop. Four stops on a ring, an ink dot travelling
// clockwise. Each stop inverts (ink fill, memo text) while the dot is there.
import { STAGES } from '../lib/site';

const cx = 200, cy = 200, r = 140;
const stops = [
  { key: 'dumb', x: cx, y: cy - r, w: 84 },
  { key: 'working', x: cx + r, y: cy, w: 104 },
  { key: 'everywhere', x: cx, y: cy + r, w: 128 },
  { key: 'boring', x: cx - r, y: cy, w: 96 },
] as const;

const pt = (deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const arrows = [-45, 45, 135, 225].map((deg) => {
  const [x, y] = pt(deg);
  return { x, y, rot: deg + 90 };
});
const path = `M${cx},${cy - r} A${r},${r} 0 0 1 ${cx},${cy + r} A${r},${r} 0 0 1 ${cx},${cy - r}`;
---
<figure class="loop border border-ink p-4 sm:p-6 bg-memo">
  <figcaption class="t-label text-muted flex justify-between gap-4 border-b border-rule pb-3 mb-2">
    <span>Fig. 1: The dumb idea loop</span>
    <span aria-hidden="true">§1–§4</span>
  </figcaption>
  <svg viewBox="0 0 400 400" class="w-full h-auto max-w-[420px] mx-auto block" role="img"
    aria-label="The dumb idea loop: dumb, then working, then everywhere, then boring, then a new dumb idea starts it again.">
    <circle cx={cx} cy={cy} r={r} fill="none" stroke="var(--ink)" stroke-width="1" />
    {arrows.map((a) => (
      <polygon points="-5,-5 6,0 -5,5" fill="var(--ink)" transform={`translate(${a.x} ${a.y}) rotate(${a.rot})`} />
    ))}

    <text x={cx} y={cy - 4} text-anchor="middle" font-family="'Space Mono', monospace" font-size="11" letter-spacing="0.66" fill="var(--muted)">REPEAT</text>
    <text x={cx} y={cy + 14} text-anchor="middle" font-family="'Space Mono', monospace" font-size="11" fill="var(--muted)">↻</text>

    <circle r="6" fill="var(--ink)">
      <animateMotion dur="10s" repeatCount="indefinite" path={path} />
    </circle>

    {stops.map((s, i) => (
      <g class={`stop stop-${i}`}>
        <rect x={s.x - s.w / 2} y={s.y - 15} width={s.w} height="30" stroke="var(--ink)" stroke-width="1" />
        <text x={s.x} y={s.y + 4} text-anchor="middle" font-family="'Space Mono', monospace" font-size="11" letter-spacing="0.66">
          §{STAGES[s.key].n} {STAGES[s.key].label.toUpperCase()}
        </text>
      </g>
    ))}
  </svg>
</figure>

<script>
  // SMIL ignores CSS, so pause it for people who prefer less motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.loop svg').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(0);
    });
  }
</script>

<style>
  .stop rect { fill: var(--memo); animation: stop-fill 10s linear infinite; }
  .stop text { fill: var(--ink); animation: stop-text 10s linear infinite; }
  /* Centre each inversion on the moment the dot arrives (every 2.5s). */
  .stop-0 rect, .stop-0 text { animation-delay: -0.7s; }
  .stop-1 rect, .stop-1 text { animation-delay: 1.8s; }
  .stop-2 rect, .stop-2 text { animation-delay: 4.3s; }
  .stop-3 rect, .stop-3 text { animation-delay: 6.8s; }
  @keyframes stop-fill {
    0%, 14% { fill: var(--ink); }
    15%, 100% { fill: var(--memo); }
  }
  @keyframes stop-text {
    0%, 14% { fill: var(--memo); }
    15%, 100% { fill: var(--ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stop rect, .stop text { animation: none; }
    .stop-0 rect { fill: var(--ink); }
    .stop-0 text { fill: var(--memo); }
  }
</style>
