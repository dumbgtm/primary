---
// Paperclipped card (Graphics Kit §04.2): featured posts, embeds, attachments.
import Icon from './Icon.astro';
interface Props { label?: string; class?: string }
const { label = 'Attachment A', class: extra = '' } = Astro.props;
---
<div class:list={['relative border border-ink bg-memo pt-6 px-5 pb-5', extra]}>
  <span class="absolute left-[18px] top-[-20px] bg-memo text-ink" style="transform: rotate(-8deg)">
    <Icon name="paperclip" size={40} />
  </span>
  <p class="t-label text-muted mb-2">{label}</p>
  <slot />
</div>
