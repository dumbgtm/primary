---
---
<div class="hero-visual rounded-2xl bg-frost/15 border border-ink/10 p-6 sm:p-8">
  <svg viewBox="0 0 400 320" class="w-full h-auto" aria-hidden="true" focusable="false">
    <!-- speech bubble -->
    <rect x="36" y="6" width="170" height="52" rx="14" fill="#FFFFFF" stroke="#1D3354" stroke-opacity="0.15" stroke-width="1.5" />
    <path d="M92,56 L108,56 L97,70 Z" fill="#FFFFFF" stroke="#1D3354" stroke-opacity="0.15" stroke-width="1.5" />
    <text x="121" y="28" text-anchor="middle" class="pitch-line pitch-line-1 font-display font-extrabold fill-ink" font-size="12.5">
      <tspan x="121">10X YOUR</tspan>
      <tspan x="121" dy="16">PIPELINE</tspan>
    </text>
    <text x="121" y="28" text-anchor="middle" class="pitch-line pitch-line-2 font-display font-extrabold fill-ink" font-size="12.5">
      <tspan x="121">AI-POWERED</tspan>
      <tspan x="121" dy="16">SYNERGY</tspan>
    </text>
    <text x="121" y="28" text-anchor="middle" class="pitch-line pitch-line-3 font-display font-extrabold fill-ink" font-size="12.5">
      <tspan x="121">QUICK 15-MIN</tspan>
      <tspan x="121" dy="16">CALL?</tspan>
    </text>

    <!-- robot -->
    <g class="antenna">
      <line x1="105" y1="72" x2="105" y2="52" stroke="#1D3354" stroke-width="3" stroke-linecap="round" />
      <circle cx="105" cy="48" r="6" fill="#D64045" />
    </g>
    <rect x="70" y="72" width="70" height="56" rx="14" fill="#467599" />
    <rect x="88" y="94" width="10" height="10" rx="3" fill="#E9FFF9" class="eye" />
    <rect x="118" y="94" width="10" height="10" rx="3" fill="#E9FFF9" class="eye" />
    <rect x="58" y="128" width="94" height="92" rx="18" fill="#1D3354" />
    <rect x="76" y="146" width="58" height="42" rx="6" fill="#E9FFF9" />
    <rect x="84" y="164" width="8" height="18" rx="2" fill="#D64045" class="bar bar-1" />
    <rect x="96" y="158" width="8" height="24" rx="2" fill="#D64045" class="bar bar-2" />
    <rect x="108" y="168" width="8" height="14" rx="2" fill="#D64045" class="bar bar-3" />
    <rect x="120" y="152" width="8" height="30" rx="2" fill="#D64045" class="bar bar-4" />
    <rect x="70" y="220" width="16" height="34" rx="5" fill="#467599" />
    <rect x="126" y="220" width="16" height="34" rx="5" fill="#467599" />
    <ellipse cx="78" cy="258" rx="14" ry="6" fill="#1D3354" fill-opacity="0.6" />
    <ellipse cx="134" cy="258" rx="14" ry="6" fill="#1D3354" fill-opacity="0.6" />

    <g class="pitch-arm">
      <rect x="150" y="142" width="54" height="14" rx="7" fill="#467599" />
      <rect x="196" y="126" width="40" height="30" rx="5" fill="#FFFFFF" stroke="#1D3354" stroke-opacity="0.15" />
      <polyline points="202,148 210,136 218,142 226,130 232,134" fill="none" stroke="#D64045" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>

    <g class="pitch-arrow">
      <polygon points="236,140 252,146 236,152" fill="#D64045" />
    </g>

    <!-- human -->
    <g class="head-shake">
      <circle cx="300" cy="98" r="32" fill="#E9FFF9" stroke="#1D3354" stroke-width="3" />
      <line x1="282" y1="88" x2="296" y2="84" stroke="#1D3354" stroke-width="3" stroke-linecap="round" />
      <circle cx="288" cy="98" r="3" fill="#1D3354" />
      <circle cx="312" cy="98" r="3" fill="#1D3354" />
      <line x1="286" y1="116" x2="312" y2="116" stroke="#1D3354" stroke-width="3" stroke-linecap="round" />
    </g>
    <rect x="260" y="132" width="80" height="92" rx="20" fill="#5B6B85" />
    <rect x="270" y="158" width="60" height="14" rx="7" fill="#1D3354" transform="rotate(20 300 165)" />
    <rect x="270" y="158" width="60" height="14" rx="7" fill="#1D3354" transform="rotate(-20 300 165)" />
    <rect x="270" y="224" width="16" height="34" rx="5" fill="#5B6B85" />
    <rect x="314" y="224" width="16" height="34" rx="5" fill="#5B6B85" />
    <ellipse cx="278" cy="262" rx="14" ry="6" fill="#1D3354" fill-opacity="0.6" />
    <ellipse cx="322" cy="262" rx="14" ry="6" fill="#1D3354" fill-opacity="0.6" />
  </svg>
</div>

<style>
  .hero-visual svg {
    overflow: visible;
  }

  .antenna {
    transform-origin: 105px 72px;
    animation: antenna-bob 2.4s ease-in-out infinite;
  }

  .eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 4.5s ease-in-out infinite;
  }

  .bar {
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .bar-1 { animation: bar-grow 2.2s ease-in-out infinite; }
  .bar-2 { animation: bar-grow 2.2s ease-in-out infinite 0.2s; }
  .bar-3 { animation: bar-grow 2.2s ease-in-out infinite 0.4s; }
  .bar-4 { animation: bar-grow 2.2s ease-in-out infinite 0.6s; }

  .pitch-arm {
    transform-origin: 152px 148px;
    animation: pitch-arm-rock 1.8s ease-in-out infinite;
  }

  .pitch-arrow {
    animation: pitch-arrow-travel 2.6s ease-in infinite;
  }

  .head-shake {
    transform-box: fill-box;
    transform-origin: 300px 98px;
    animation: head-shake 3.2s ease-in-out infinite;
  }

  .pitch-line {
    opacity: 0;
    animation: pitch-fade 9s ease-in-out infinite;
  }
  .pitch-line-1 { animation-delay: 0s; }
  .pitch-line-2 { animation-delay: 3s; }
  .pitch-line-3 { animation-delay: 6s; }

  @keyframes antenna-bob {
    0%, 100% { transform: rotate(-6deg); }
    50% { transform: rotate(6deg); }
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes bar-grow {
    0%, 100% { transform: scaleY(0.65); }
    50% { transform: scaleY(1); }
  }
  @keyframes pitch-arm-rock {
    0%, 100% { transform: rotate(-4deg); }
    50% { transform: rotate(6deg); }
  }
  @keyframes pitch-arrow-travel {
    0% { transform: translateX(0); opacity: 0; }
    15% { opacity: 1; }
    70% { transform: translateX(64px); opacity: 1; }
    100% { transform: translateX(70px); opacity: 0; }
  }
  @keyframes head-shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-5deg); }
    75% { transform: rotate(5deg); }
  }
  @keyframes pitch-fade {
    0%, 3% { opacity: 0; }
    6%, 27% { opacity: 1; }
    31%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .antenna, .eye, .bar, .pitch-arm, .pitch-arrow, .head-shake, .pitch-line {
      animation: none;
    }
    .pitch-line-1 { opacity: 1; }
  }
</style>
