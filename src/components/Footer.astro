---
const year = new Date().getFullYear();
---
<footer class="mt-16 sm:mt-24 bg-memo">
  <div class="container-memo pt-0 pb-10">
    <div class="double-rule"></div>
    <div class="pt-6 grid gap-6 sm:grid-cols-[1fr_auto] text-[11px] text-muted font-mono leading-[1.6]">
      <div>
        <a href="/" aria-label="dumbgtm home" class="inline-block mb-3"><img src="/brand/dumbgtm-wordmark.svg" alt="dumbgtm" width="124" height="28" class="h-7 w-auto block" /></a>
        <p>Celebrating dumb marketing ideas.</p>
      </div>
      <div class="sm:text-right space-y-1">
        <p class="t-label space-x-4">
          <a href="/dumb-ideas" class="footer-link">Dumb Ideas</a>
          <a href="/blog" class="footer-link">Blog</a>
          <a href="/about" class="footer-link">About</a>
          <a href="/contact" class="footer-link">Contact</a>
        </p>
        <p>&copy; {year} dumbGTM. This document will self-file in 30 days.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link { color: var(--ink); transition: background-color 120ms ease-out; }
  .footer-link:hover { background: var(--highlighter); }
</style>
