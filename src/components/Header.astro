---
import Icon from './Icon.astro';
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<header class="container-memo pt-5">
  <div class="relative flex items-center gap-6 border-b border-ink pb-3">
    <a href="/" aria-label="dumbgtm home" class="shrink-0 block">
      <img src="/brand/dumbgtm-wordmark.svg" alt="dumbgtm" width="97" height="22" class="h-5 sm:h-[22px] w-auto block" />
    </a>

    <nav class="ml-auto hidden sm:flex items-center gap-6" aria-label="Main">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={['nav-link t-label whitespace-nowrap px-1 py-1', isActive(item.href) && 'nav-active']}>
          {item.label}
        </a>
      ))}
    </nav>

    <button type="button" class="nav-toggle sm:hidden ml-auto p-2 -mr-2 text-ink" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="icon-open"><Icon name="menu" size={20} /></span>
      <span class="icon-close hidden"><Icon name="close" size={20} /></span>
    </button>

    <nav id="mobile-nav" class="mobile-nav hidden sm:hidden absolute left-0 right-0 top-full z-20 bg-memo border-b border-ink" aria-label="Main">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={['nav-link t-label block px-1 py-4 border-t border-rule', isActive(item.href) && 'nav-active']}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu?.classList.toggle('hidden', !open);
    btn.querySelector('.icon-open')?.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>

<style>
  .nav-link { color: var(--ink); transition: background-color 120ms ease-out, color 120ms ease-out; }
  .nav-link:hover { background: var(--highlighter); }
  .nav-active { text-decoration: underline; text-underline-offset: 4px; }
</style>
