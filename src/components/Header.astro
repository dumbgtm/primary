---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---
<header class="container-memo pt-5">
  <div class="flex items-center gap-6 border-b border-ink pb-3">
    <a href="/" class="font-serif font-bold text-[18px] text-ink lowercase shrink-0 focus-visible:outline-2">dumbgtm</a>
    <nav class="ml-auto flex items-center gap-4 sm:gap-6 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="Main">
      {navItems.map((item) => {
        const active = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={['nav-link t-label whitespace-nowrap px-1 py-1', active && 'nav-active']}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .nav-link { color: var(--ink); transition: background-color 120ms ease-out, color 120ms ease-out; }
  .nav-link:hover { background: var(--highlighter); }
  .nav-active { text-decoration: underline; text-underline-offset: 4px; }
</style>
