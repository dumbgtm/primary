---
interface Props { href: string; label: string; primary?: boolean }
const { href, label, primary = false } = Astro.props;
---
{href ? (
  <a href={href} target="_blank" rel="noopener" class={primary ? 'btn-primary' : 'btn-secondary'}>{label} →</a>
) : (
  <span class="btn-disabled" aria-disabled="true" title="Channel launching soon">{label} (pending approval)</span>
)}
